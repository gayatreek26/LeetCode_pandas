import pandas as pd

def tree_node(tree: pd.DataFrame) -> pd.DataFrame:
    parent_ids = set(tree["id"])
    
    def get_type(row):
        if pd.isna(row["p_id"]):
            return "Root"
        elif row["id"] not in set(tree["p_id"].dropna()):
            return "Leaf"
        else:
            return "Inner"

    tree["type"] = tree.apply(get_type, axis=1)

    return tree[["id", "type"]]
