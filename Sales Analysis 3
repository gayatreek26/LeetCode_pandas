import pandas as pd

def sales_analysis(product: pd.DataFrame,
                   sales: pd.DataFrame) -> pd.DataFrame:

    result = sales.merge(product, on="product_id")

    # Products sold only between 2019-01-01 and 2019-03-31
    result = result.groupby(
        ["product_id", "product_name"]
    )["sale_date"].agg(["min", "max"]).reset_index()

    result = result[
        (result["min"] >= "2019-01-01") &
        (result["max"] <= "2019-03-31")
    ]

    return result[["product_id", "product_name"]]
