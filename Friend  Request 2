import pandas as pd

def most_friends(request_accepted: pd.DataFrame) -> pd.DataFrame:
    sent = request_accepted["requester_id"].value_counts()
    received = request_accepted["accepter_id"].value_counts()

    total = sent.add(received, fill_value=0)

    customer = total.idxmax()
    friends = int(total.max())

    return pd.DataFrame({
        "id": [customer],
        "num": [friends]
    })
